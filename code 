 
#include <iostream>
#include <string>
using namespace std;

struct Vehicle {
    int id;
    string name, type;
    float price;
    Vehicle *next;

    Vehicle(int i, string n, string t, float p) {
        id = i;
        name = n;
        type = t;
        price = p;
        next = NULL;
    }
};

class VehicleList {
    Vehicle *head;

public:
    VehicleList() {
        head = NULL;
    }

    void add() {
        int id;
        string name, type;
        float price;

        cout << "Enter ID: ";
        cin >> id;

        cout << "Enter Name: ";
        cin >> name;

        cout << "Enter Type: ";
        cin >> type;

        cout << "Enter Price: ";
        cin >> price;

        Vehicle *n = new Vehicle(id, name, type, price);

        if (head == NULL)
            head = n;
        else {
            Vehicle *p = head;
            while (p->next)
                p = p->next;
            p->next = n;
        }

        cout << "Added successfully\n";
    }

    void display() {
        Vehicle *p = head;

        if (p == NULL) {
            cout << "No vehicles available\n";
            return;
        }

        while (p) {
            cout << "ID: " << p->id
                 << "\nName: " << p->name
                 << "\nType: " << p->type
                 << "\nPrice: " << p->price << endl;
            p = p->next;
        }
    }

    void search(int id) {
        Vehicle *p = head;

        while (p) {
            if (p->id == id) {
                cout << "Found:\n";
                cout << "Name: " << p->name
                     << "\nType: " << p->type
                     << "\nPrice: " << p->price << endl;
                return;
            }
            p = p->next;
        }

        cout << "Vehicle not found\n";
    }

    void remove(int id) {
        Vehicle *p = head, *q = NULL;

        while (p && p->id != id) {
            q = p;
            p = p->next;
        }

        if (!p) {
            cout << "Vehicle not found\n";
            return;
        }

        if (q)
            q->next = p->next;
        else
            head = p->next;

        delete p;
        cout << "Deleted successfully\n";
    }
};

int main() {
    VehicleList v;
    int ch, id;

    do {
        cout << "\n1. Add";
        cout << "\n2. Display";
        cout << "\n3. Search";
        cout << "\n4. Delete";
        cout << "\n0. Exit";
        cout << "\nEnter your choice: ";
        cin >> ch;

        switch (ch) {
            case 1:
                v.add();
                break;

            case 2:
                v.display();
                break;

            case 3:
                cout << "Enter ID: ";
                cin >> id;
                v.search(id);
                break;

            case 4:
                cout << "Enter ID: ";
                cin >> id;
                v.remove(id);
                break;

            case 0:
                cout << "Exiting...\n";
                break;

            default:
                cout << "Invalid choice\n";
        }
    } while (ch != 0);

    return 0;
}
